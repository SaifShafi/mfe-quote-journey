{
  "name": "mfe-quote-journey",
  "private": true,
  "version": "0.1.0",
  "description": "A federated micro frontend build: one host shell composing independently deployed remotes at runtime.",
  "workspaces": ["host-shell", "remote-quote"],
  "scripts": {
    "start": "concurrently -n shell,quote -c cyan,magenta \"npm:start:shell\" \"npm:start:quote\"",
    "start:shell": "npm --workspace host-shell run start",
    "start:quote": "npm --workspace remote-quote run start",
    "build": "npm --workspace remote-quote run build && npm --workspace host-shell run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
