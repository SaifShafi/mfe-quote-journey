{
  "name": "mfe-quote-journey",
  "private": true,
  "version": "0.1.0",
  "description": "A federated micro frontend build: one host shell composing independently deployed remotes at runtime.",
  "workspaces": [
    "shared-ui",
    "host-shell",
    "remote-quote",
    "remote-account",
    "bff"
  ],
  "scripts": {
    "start": "concurrently -n bff,shell,quote,account -c green,cyan,magenta,yellow \"npm:start:bff\" \"npm:start:shell\" \"npm:start:quote\" \"npm:start:account\"",
    "start:shell": "npm --workspace host-shell run start",
    "start:quote": "npm --workspace remote-quote run start",
    "start:account": "npm --workspace remote-account run start",
    "build": "npm --workspace remote-quote run build && npm --workspace remote-account run build && npm --workspace host-shell run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure:shared": "node scripts/measure-shared.mjs",
    "measure:runtime": "node scripts/measure-runtime.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "measure:outage": "node scripts/measure-outage.mjs",
    "start:bff": "npm --workspace bff run start",
    "measure:bff": "node scripts/measure-bff.mjs",
    "measure:axe": "node scripts/measure-axe.mjs",
    "test:e2e": "playwright test",
    "measure:lazy": "node scripts/measure-lazy.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "jsdom": "^24.0.0",
    "playwright": "^1.52.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@playwright/test": "1.52.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
